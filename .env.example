# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/sentrynet?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_HOURS=24

# Ingest API Key (used by Agent and Network Monitor modules)
INGEST_API_KEY=change-me-ingest-key

# Device monitoring
HEARTBEAT_TIMEOUT_MINUTES=5
OFFLINE_CHECK_INTERVAL_SECONDS=60

# Network auto-discovery (optional)
# Set NETWORK_RANGE to enable nmap scanning instead of devices.json
# Example: 192.168.1.0/24 or 10.0.0.0/24
NETWORK_RANGE=
DISCOVERY_INTERVAL=300
